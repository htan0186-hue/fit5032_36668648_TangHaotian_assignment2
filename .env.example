# Optional Firebase Identity Platform / Firebase Auth REST configuration.
# The app works with local demo auth when this is absent.
VITE_FIREBASE_API_KEY=

# Optional email provider key for Netlify Functions.
# If absent, the send-email function returns a safe demo response.
RESEND_API_KEY=
EMAIL_FROM=SilverLink <demo@silverlink.local>

# Optional serverless export protection. If set in Netlify, export-data requires
# the same value in the X-SilverLink-Admin request header.
SILVERLINK_EXPORT_TOKEN=
